    },
    "The vehicle model was not recognized. Choose a catalog generation manually." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The vehicle model was not recognized. Choose a catalog generation manually." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Fahrzeugmodell wurde nicht erkannt. Wählen Sie eine Kataloggeneration manuell." } },
