        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "匯出失敗" } }
      }
    },
    "The report excludes server addresses, credentials, vehicle identifiers, and coordinates." : {
      "localizations" : {
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "L'informe exclou les adreces del servidor, les credencials, els identificadors del vehicle i les coordenades." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Bericht enthalt keine Serveradressen, Zugangsdaten, Fahrzeugkennungen oder Koordinaten." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The report excludes server addresses, credentials, vehicle identifiers, and coordinates." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El informe no incluye direcciones del servidor, credenciales, identificadores del vehiculo ni coordenadas." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il rapporto esclude indirizzi del server, credenziali, identificatori del veicolo e coordinate." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "报告不会包含服务器地址、认证凭据、车辆标识或坐标。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "報告不會包含伺服器位址、認證憑據、車輛識別或座標。" } }
      }
    },
    "Battery retention is calculated from data recorded by TeslaMate, not from the vehicle's full lifetime. Enter a verified new-car usable capacity or rated range in Settings to calculate absolute health." : {
      "localizations" : {
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "La retencio de la bateria es calcula amb les dades registrades per TeslaMate, no amb tota la vida util del vehicle. Introduiu a Configuracio una capacitat util nova verificada o l'autonomia nominal per calcular la salut absoluta." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Batterieerhalt wird aus den von TeslaMate aufgezeichneten Daten berechnet, nicht aus der gesamten Fahrzeuglebensdauer. Gib in den Einstellungen eine verifizierte nutzbare Neukapazitat oder Nennreichweite ein, um den absoluten Zustand zu berechnen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Battery retention is calculated from data recorded by TeslaMate, not from the vehicle's full lifetime. Enter a verified new-car usable capacity or rated range in Settings to calculate absolute health." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La retencion de la bateria se calcula con los datos registrados por TeslaMate, no con toda la vida util del vehiculo. Introduce en Ajustes una capacidad util nueva verificada o la autonomia nominal para calcular la salud absoluta." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "La ritenzione della batteria viene calcolata dai dati registrati da TeslaMate, non dall'intera vita del veicolo. Inserisci nelle Impostazioni una capacita utile da nuova verificata o l'autonomia nominale per calcolare lo stato assoluto." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前保持率根据 TeslaMate 记录期数据计算，并不代表整车寿命健康度。请在设置中填写已确认的新车可用容量或额定续航后计算绝对健康度。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前保持率根據 TeslaMate 記錄期資料計算，並不代表整車壽命健康度。請在設定中填寫已確認的新車可用容量或額定續航後計算絕對健康度。" } }
      }
    },
