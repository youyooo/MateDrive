      }
    },
    "Derived activity sessions and dashboard, activity, software-update, and widget snapshots will be cleared. Synchronized drive, charging, and location history, confirmed labels, prices, server settings, and Keychain credentials will remain.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Derived activity sessions and dashboard, activity, software-update, and widget snapshots will be cleared. Synchronized drive, charging, and location history, confirmed labels, prices, server settings, and Keychain credentials will remain." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "派生动态以及首页、动态、软件更新和小组件快照会被清除。已同步的行程、充电和位置历史、已确认标签、价格、服务器设置和钥匙串凭据会保留。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "衍生動態以及首頁、動態、軟體更新和小工具快照會被清除。已同步的行程、充電和位置記錄、已確認標籤、價格、伺服器設定和鑰匙圈憑證會保留。" } }
      }
    },
    "Could not access saved credentials. Your previous server settings were kept.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Could not access saved credentials. Your previous server settings were kept." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法访问已保存的认证凭据，已保留之前的服务器设置。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "無法存取已儲存的認證憑證，已保留之前的伺服器設定。" } }
      }
    },
    "Could not save credentials. Your previous server settings were kept.": {
