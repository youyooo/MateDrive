      }
    },
    "The reported wheels conflict with the detected factory trim. Choose the configuration that matches your vehicle." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The reported wheels conflict with the detected factory trim. Choose the configuration that matches your vehicle." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die gemeldeten Felgen widersprechen der erkannten Werksausführung. Wählen Sie die passende Konfiguration." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Las llantas indicadas no coinciden con la versión de fábrica detectada. Elige la configuración correcta." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "I cerchi indicati non corrispondono all’allestimento di fabbrica rilevato. Scegli la configurazione corretta." } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Les llandes indicades no coincideixen amb l’acabat de fàbrica detectat. Tria la configuració correcta." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "报告的轮毂与检测到的原厂版本冲突，请选择与车辆一致的配置。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "回報的輪圈與偵測到的原廠車型版本衝突，請選擇符合車輛的設定。" } }
      }
    },
    "The model year is unavailable, so the generation was inferred." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The model year is unavailable, so the generation was inferred." } },
