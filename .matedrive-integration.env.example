# Copy this file to .matedrive-integration.env. The real file is ignored by Git.
MATEDRIVE_INTEGRATION_BASE_URL=https://review-server.example

# Choose exactly one authentication method.
MATEDRIVE_INTEGRATION_API_TOKEN=
# MATEDRIVE_INTEGRATION_BASIC_USERNAME=
# MATEDRIVE_INTEGRATION_BASIC_PASSWORD=

# App Review mode rejects local, private, Tailscale-only, and plain HTTP endpoints.
MATEDRIVE_INTEGRATION_REVIEW_MODE=1
