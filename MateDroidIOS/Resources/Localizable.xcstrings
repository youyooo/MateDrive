        "es" : { "stringUnit" : { "state" : "translated", "value" : "Introduce un precio predeterminado válido y no negativo." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Inserisci un prezzo predefinito valido e non negativo." } },
