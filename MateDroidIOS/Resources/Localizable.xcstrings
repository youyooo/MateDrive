    "The model year falls outside the catalog range. Check the detected generation." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The model year falls outside the catalog range. Check the detected generation." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Modelljahr liegt außerhalb des Katalogbereichs. Prüfen Sie die erkannte Generation." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El año del modelo está fuera del intervalo del catálogo. Comprueba la generación detectada." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "L’anno modello è fuori dall’intervallo del catalogo. Controlla la generazione rilevata." } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "L’any del model queda fora de l’interval del catàleg. Comprova la generació detectada." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "车型年份超出目录范围，请检查检测到的代际。" } },
