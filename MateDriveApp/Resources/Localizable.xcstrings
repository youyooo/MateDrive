    "Battery Health Note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If TeslaMate started recording late, enter the new-car full rated range to calculate health from today's 100% range."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 TeslaMate 是车辆行驶很久后才开始记录，请填入新车满电额定续航；电池健康会用当前估算满电续航和该参考值计算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 TeslaMate 是車輛行駛很久後才開始記錄，請填入新車滿電額定續航；電池健康會用當前估算滿電續航和該參考值計算。"
          }
        }
      }
    },
    "Battery History": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery History"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池历史"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電池歷史"
          }
        }
      }
    },
    "Battery retention is calculated from data recorded by TeslaMate, not from the vehicle's full lifetime. Enter a verified new-car usable capacity or rated range in Settings to calculate absolute health.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery retention is calculated from data recorded by TeslaMate, not from the vehicle's full lifetime. Enter a verified new-car usable capacity or rated range in Settings to calculate absolute health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前保持率根据 TeslaMate 记录期数据计算，并不代表整车寿命健康度。请在设置中填写已确认的新车可用容量或额定续航后计算绝对健康度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前保持率根據 TeslaMate 記錄期資料計算，並不代表整車壽命健康度。請在設定中填寫已確認的新車可用容量或額定續航後計算絕對健康度。"
          }
        }
      }
    },
