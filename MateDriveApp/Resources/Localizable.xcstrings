    "Calculated only from available TeslaMate API samples. Missing metrics are excluded instead of scored as zero; this is not Tesla's Safety Score.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculated only from available TeslaMate API samples. Missing metrics are excluded instead of scored as zero; this is not Tesla's Safety Score."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅使用服务器已记录的有效样本计算；缺失指标会被排除，不会按 0 分处理。本评分并非特斯拉官方安全评分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅使用伺服器已記錄的有效樣本計算；缺少的指標會被排除，不會按 0 分處理。本評分並非特斯拉官方安全評分。"
          }
        }
      }
