    "Matched from vehicle details with catalog defaults where data was unavailable." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Matched from vehicle details with catalog defaults where data was unavailable." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Anhand der Fahrzeugdetails zugeordnet; fehlende Daten wurden durch Katalogstandardwerte ergänzt." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Coincidencia a partir de los datos del vehículo, usando valores predeterminados del catálogo cuando faltaban datos." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Corrispondenza dai dati del veicolo, con valori predefiniti del catalogo per i dati mancanti." } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Coincidència a partir de les dades del vehicle, amb valors predeterminats del catàleg quan faltaven dades." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "根据车辆信息匹配，缺失数据使用目录默认值。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "根據車輛資訊配對，缺少資料時使用目錄預設值。" } }
