        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所选规则估算写入 TeslaMate API？已有接口费用仅在明确勾选后才会更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將所選規則估算寫入 TeslaMate API？已有介面費用僅在明確勾選後才會更改。"
          }
        }
      }
    },
