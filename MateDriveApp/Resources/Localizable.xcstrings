    "This is an estimate from TeslaMate records and your calibration reference, not a physical battery diagnosis.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is an estimate from TeslaMate records and your calibration reference, not a physical battery diagnosis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该结果根据 TeslaMate 记录和你的校准参考值估算，并非电池物理检测结论。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該結果根據 TeslaMate 記錄和你的校準參考值估算，並非電池物理檢測結論。"
          }
        }
      }
    },
    "Recording-period retention does not represent lifetime battery health. Add a verified new-car reference before drawing a degradation conclusion.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording-period retention does not represent lifetime battery health. Add a verified new-car reference before drawing a degradation conclusion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录期保持率不代表整车寿命健康度；填写已确认的新车参考值后，才能判断长期衰减。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄期保持率不代表整車壽命健康度；填寫已確認的新車參考值後，才能判斷長期衰減。"
          }
        }
      }
    },
