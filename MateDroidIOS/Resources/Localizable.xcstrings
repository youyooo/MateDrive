        "en" : { "stringUnit" : { "state" : "translated", "value" : "Latitude, longitude, and radius must be entered together." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La latitud, la longitud y el radio deben introducirse juntos." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Latitudine, longitudine e raggio devono essere inseriti insieme." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "纬度、经度和半径必须同时填写。" } },
