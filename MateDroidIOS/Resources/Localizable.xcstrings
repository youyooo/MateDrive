    "The saved configuration is no longer available. Automatic matching has been restored." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The saved configuration is no longer available. Automatic matching has been restored." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die gespeicherte Konfiguration ist nicht mehr verfügbar. Die automatische Zuordnung wurde wiederhergestellt." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La configuración guardada ya no está disponible. Se ha restaurado la coincidencia automática." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "La configurazione salvata non è più disponibile. È stata ripristinata la corrispondenza automatica." } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "La configuració desada ja no està disponible. S’ha restaurat la coincidència automàtica." } },
