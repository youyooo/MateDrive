    "Export Failed" : {
      "localizations" : {
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "L'exportacio ha fallat" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Export fehlgeschlagen" } },
