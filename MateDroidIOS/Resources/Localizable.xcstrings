    "Battery Health Note" : {
      "localizations" : {
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Si TeslaMate va començar a registrar tard, introduïu l'autonomia nominal completa del vehicle nou per calcular la salut a partir de l'autonomia actual al 100 %." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wenn TeslaMate erst spät mit der Aufzeichnung begonnen hat, gib die Nennreichweite des Neufahrzeugs ein, um den Zustand anhand der heutigen Reichweite bei 100 % zu berechnen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "If TeslaMate started recording late, enter the new-car full rated range to calculate health from today's 100% range." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Si TeslaMate empezó a registrar tarde, introduce la autonomía nominal completa del vehículo nuevo para calcular el estado a partir de la autonomía actual al 100 %." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Se TeslaMate ha iniziato a registrare tardi, inserisci l'autonomia nominale completa del veicolo nuovo per calcolare lo stato dall'autonomia attuale al 100%." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "如果 TeslaMate 是车辆行驶很久后才开始记录，请填入新车满电额定续航；电池健康会用当前估算满电续航和该参考值计算。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "如果 TeslaMate 是車輛行駛很久後才開始記錄，請填入新車滿電額定續航；電池健康會用當前估算滿電續航和該參考值計算。" } }
      }
    },
