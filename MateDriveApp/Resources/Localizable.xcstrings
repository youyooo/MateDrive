{
  "sourceLanguage": "en",
  "strings": {
    "Advanced Connection Options": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Advanced Connection Options" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "高级连接选项" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "進階連線選項" } }
      }
    },
    "Connect TeslaMate": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Connect TeslaMate" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "连接 TeslaMate" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "連接 TeslaMate" } }
      }
    },
    "Connect server": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Connect server" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "连接服务器" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "連接伺服器" } }
      }
    },
    "Connect your TeslaMate server": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Connect your TeslaMate server" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "连接你的 TeslaMate 服务器" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "連接你的 TeslaMate 伺服器" } }
      }
    },
    "MateDrive verifies server and data access before saving.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "MateDrive verifies server and data access before saving." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "保存前，MateDrive 会验证服务器和数据访问。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "儲存前，MateDrive 會驗證伺服器和資料存取。" } }
      }
    },
    "Verify & Continue": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Verify & Continue" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "验证并继续" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "驗證並繼續" } }
      }
    },
    "Independent App": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Independent App" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "独立应用声明" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "獨立應用聲明" } }
      }
    },
    "Route Weather": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Route Weather" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "路线天气" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "路線天氣" } }
      }
    },
    "To load weather for this drive, MateDrive sends one representative precise route coordinate and the drive time to Open-Meteo. Open-Meteo may retain request logs for up to 90 days. You can turn this off and clear saved weather in Privacy & Local Data.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "To load weather for this drive, MateDrive sends one representative precise route coordinate and the drive time to Open-Meteo. Open-Meteo may retain request logs for up to 90 days. You can turn this off and clear saved weather in Privacy & Local Data." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "如需加载本次行程天气，MateDrive 会向 Open-Meteo 发送一个代表性的精确路线坐标和行程时间。Open-Meteo 可能将请求日志保留最长 90 天。你可以随时在“隐私与本地数据”中关闭并清除已保存天气。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "如需載入本次行程天氣，MateDrive 會向 Open-Meteo 傳送一個代表性的精確路線座標和行程時間。Open-Meteo 可能將請求日誌保留最長 90 天。你可以隨時在「隱私與本機資料」中關閉並清除已儲存天氣。" } }
      }
    },
    "Could not save this permission. Try again.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Could not save this permission. Try again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法保存此授权，请重试。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "無法儲存此授權，請再試一次。" } }
      }
    },
    "Enabling Route Weather": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Enabling Route Weather" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "正在启用路线天气" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "正在啟用路線天氣" } }
      }
    },
    "Enable Route Weather": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Enable Route Weather" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "启用路线天气" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "啟用路線天氣" } }
      }
    },
    "Apple map and geocoding services process map locations. Route weather stays off until you enable it. When enabled, one representative precise route coordinate and the drive time are sent to Open-Meteo. Open-Meteo may retain request logs for up to 90 days and states that it does not link them to user identities or use them for tracking.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Apple map and geocoding services process map locations. Route weather stays off until you enable it. When enabled, one representative precise route coordinate and the drive time are sent to Open-Meteo. Open-Meteo may retain request logs for up to 90 days and states that it does not link them to user identities or use them for tracking." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "苹果地图和地理编码服务会处理地图位置。路线天气默认关闭，只有你主动启用后，应用才会向 Open-Meteo 发送一个代表性的精确路线坐标和行程时间。该服务可能将请求日志保留最长 90 天，并声明不会将其关联到用户身份或用于跟踪。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "蘋果地圖和地理編碼服務會處理地圖位置。路線天氣預設關閉，只有你主動啟用後，應用程式才會向 Open-Meteo 傳送一個代表性的精確路線座標和行程時間。該服務可能將請求日誌保留最長 90 天，並聲明不會將其關聯至使用者身分或用於追蹤。" } }
      }
    },
    "Allow Open-Meteo Route Weather": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Allow Open-Meteo Route Weather" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "允许 Open-Meteo 路线天气" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "允許 Open-Meteo 路線天氣" } }
      }
    },
    "Turning this off stops future Open-Meteo requests. Previously saved weather remains on this device until you clear it below.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Turning this off stops future Open-Meteo requests. Previously saved weather remains on this device until you clear it below." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "关闭后将停止后续 Open-Meteo 请求。此前保存的天气仍保留在本机，直到你在下方清除。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "關閉後將停止後續 Open-Meteo 請求。先前儲存的天氣仍保留在本機，直到你在下方清除。" } }
      }
    },
    "Clear Saved Route Weather": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Clear Saved Route Weather" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "清除已保存路线天气" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "清除已儲存路線天氣" } }
      }
    },
    "Clear all saved route weather?": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Clear all saved route weather?" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "清除全部已保存路线天气？" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "清除全部已儲存路線天氣？" } }
      }
    },
    "Clear Route Weather": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Clear Route Weather" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "清除路线天气" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "清除路線天氣" } }
      }
    },
    "Saved Open-Meteo results will be removed from this device. Your route-weather permission and TeslaMate data will not change.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Saved Open-Meteo results will be removed from this device. Your route-weather permission and TeslaMate data will not change." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "本机保存的 Open-Meteo 天气结果将被删除。路线天气授权状态和 TeslaMate 数据不会改变。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "本機儲存的 Open-Meteo 天氣結果將被刪除。路線天氣授權狀態和 TeslaMate 資料不會改變。" } }
      }
    },
    "Route Weather Cleared": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Route Weather Cleared" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "路线天气已清除" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "路線天氣已清除" } }
      }
    },
    "MateDrive is an independently developed, unofficial iOS app. It is not affiliated with, sponsored by, or endorsed by Tesla, Inc., TeslaMate, or any other service provider. Product and service names are used only to describe compatibility.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MateDrive is an independently developed, unofficial iOS app. It is not affiliated with, sponsored by, or endorsed by Tesla, Inc., TeslaMate, or any other service provider. Product and service names are used only to describe compatibility."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MateDrive 是独立开发的非官方 iOS 应用，与特斯拉公司、TeslaMate 或其他服务提供方不存在隶属、赞助或官方认可关系。产品与服务名称仅用于说明兼容性，相关商标归各自权利人所有。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MateDrive 是獨立開發的非官方 iOS 應用，與特斯拉公司、TeslaMate 或其他服務提供方不存在隸屬、贊助或官方認可關係。產品與服務名稱僅用於說明相容性，相關商標歸各自權利人所有。"
          }
        }
      }
    },
    "AC charging was recorded": {
      "localizations": {
