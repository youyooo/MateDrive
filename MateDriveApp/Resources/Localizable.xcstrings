    "This is a suggestion. Use Edit activity label to correct it; your choice will take priority.": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This is a suggestion. Use Edit activity label to correct it; your choice will take priority." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "这是智能建议。可通过“编辑动态标签”纠正，你的选择会被优先采用。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "這是智能建議。可透過「編輯動態標籤」更正，你的選擇會被優先採用。" } }
      }
    },
    "User confirmed": {
