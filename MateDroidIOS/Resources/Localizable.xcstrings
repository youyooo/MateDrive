        "es" : { "stringUnit" : { "state" : "translated", "value" : "El año del modelo no está disponible, por lo que se ha inferido la generación." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "L’anno modello non è disponibile, quindi la generazione è stata dedotta." } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "L’any del model no està disponible, així que s’ha inferit la generació." } },
