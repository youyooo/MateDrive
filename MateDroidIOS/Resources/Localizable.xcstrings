        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il modello del veicolo non è stato riconosciuto. Scegli manualmente una generazione dal catalogo." } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "No s’ha reconegut el model del vehicle. Tria manualment una generació del catàleg." } },
