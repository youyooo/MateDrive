          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作会永久删除已确认的动态标签和充电价格观察，并清除派生动态。TeslaMate 原始数据、服务器设置和钥匙串凭据不会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
