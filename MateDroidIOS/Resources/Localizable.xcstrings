    "Write the selected rule estimates to TeslaMate API? Existing API costs are changed only when explicitly selected." : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write the selected rule estimates to TeslaMate API? Existing API costs are changed only when explicitly selected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所选规则估算写入 TeslaMate API？已有接口费用仅在明确勾选后才会更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將所選規則估算寫入 TeslaMate API？已有介面費用僅在明確勾選後才會更改。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewahlten Regelschatzungen in die TeslaMate API schreiben? Vorhandene API-Kosten werden nur bei expliziter Auswahl geandert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribir las estimaciones de reglas seleccionadas en la API de TeslaMate? Los costes existentes solo cambian si se seleccionan explicitamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivere le stime delle regole selezionate nell'API TeslaMate? I costi API esistenti cambiano solo se selezionati esplicitamente."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
